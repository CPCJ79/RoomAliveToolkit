<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>RoomAliveToolkit</RootNamespace>
    <AssemblyName>CalibrateEnsemble</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.7.0" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.7.0" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.7.0" />
    <PackageReference Include="Vortice.DXGI" Version="3.7.0" />
    <PackageReference Include="Vortice.DirectX" Version="3.7.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProCamEnsembleCalibration\ProCamEnsembleCalibrationLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Shaders\Output\*.cso" Link="Content\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
